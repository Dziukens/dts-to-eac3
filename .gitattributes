# Windows scripts: always CRLF (cmd.exe misreads LF-only batch files).
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.md   text eol=lf
.git*  text eol=lf

# Left out of the release package (git archive).
.gitattributes     export-ignore
.gitignore         export-ignore
build-release.ps1  export-ignore
CHANGELOG.md       export-ignore
tests/             export-ignore
