# Skrypty Windows: zawsze CRLF (cmd.exe źle czyta pliki z samym LF).
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.md   text eol=lf
.git*  text eol=lf

# Pomijane w paczce release (git archive).
.gitattributes     export-ignore
.gitignore         export-ignore
build-release.ps1  export-ignore
CHANGELOG.md       export-ignore
